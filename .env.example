# Anthropic (Claude writes the spoken warnings)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Cartesia
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_VOICE_ID=
CARTESIA_CHECKIN_AGENT_ID=

# Creao: one app-scoped capi_ key per agent (each key only runs its own agent)
CREAO_CONDITIONS_API_KEY=
CREAO_TERRAIN_API_KEY=
CREAO_ROUTE_API_KEY=
CREAO_INCIDENT_API_KEY=
CREAO_CONDITIONS_AGENT_ID=
CREAO_TERRAIN_AGENT_ID=
CREAO_ROUTE_AGENT_ID=
CREAO_INCIDENT_AGENT_ID=
CREAO_WORKFLOW_ID=

# App settings
DEMO_MODE=true
CHECKIN_COUNTDOWN_SECONDS=30
CHECKIN_REMINDER_SECONDS=10
PORT=8000
# Geofence tuning (defaults in backend/config.py)
GEOFENCE_SMOOTHING_FIXES=5
GEOFENCE_WARNING_BASE_M=30
GEOFENCE_WARNING_LEAD_S=8
GEOFENCE_NEAR_M=15
GEOFENCE_PATH_MARGIN_M=10
GEOFENCE_CONFIRM_FIXES=2
GEOFENCE_CLOSURE_WARNING_BASE_M=15
GEOFENCE_CLOSURE_WARNING_LEAD_S=4
GEOFENCE_CLOSURE_CONFIRM_FIXES=5
GEOFENCE_CLOSURE_NEAR_M=5
GEOFENCE_CLOSURE_PATH_MARGIN_M=0
COORDINATOR_TIMEOUT_S=1.5
COORDINATOR_MAX_WORDS=15
CLIFF_STOP_M=15
COORDINATOR_BRIEFING_MAX_WORDS=30
CLIFF_EDGE_M=8
CLIFF_RAY_SPREAD_DEG=6
GEOFENCE_MAX_ACCURACY_M=15
GEOFENCE_JUMP_GATE_M=20
GEOFENCE_JUMP_ACCEPT_FIXES=4
CLIFF_QUIET_AFTER_WARNING_S=8
ON_LINE_M=12
ON_LINE_CONFIRM_FIXES=2

# Crash check-in detector and cancel (defaults in backend/config.py)
FAST_KMH=25
STOP_KMH=10
SUDDEN_DROP_S=3
STILL_S=4
NORMAL_KMH=15
NORMAL_FIXES=3
# The check-in agent's client tool names, and the only tool IDs it may have (comma separated)
CHECKIN_TOOL_OK=skier_ok
CHECKIN_TOOL_HELP=request_help
CHECKIN_ALLOWED_TOOL_IDS=

# Public demo (Render): set CAIRN_PUBLIC_DEMO=1 as an environment variable on the host (render.yaml
# already does). It turns off every endpoint that spends Creao credits. Leave ANTHROPIC_API_KEY,
# CARTESIA_API_KEY, CARTESIA_CHECKIN_AGENT_ID and the CREAO_*_API_KEY vars unset there; add secrets
# only in the host's dashboard, never in git.
CAIRN_PUBLIC_DEMO=
